{
  "name": "supervisord-console",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "test": "node --test tests/*.test.mjs",
    "test:e2e": "node scripts/smoke.mjs",
    "format": "prettier --write src tests scripts vite.config.js index.html package.json",
    "format:check": "prettier --check src tests scripts vite.config.js index.html package.json"
  },
  "dependencies": {
    "@element-plus/icons-vue": "2.3.2",
    "element-plus": "2.14.7",
    "vue": "3.5.44",
    "vue-router": "5.4.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@vitejs/plugin-vue": "6.0.10",
    "prettier": "3.9.10",
    "unplugin-vue-components": "32.1.0",
    "vite": "8.3.4"
  }
}
