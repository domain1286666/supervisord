[Unit]
Description=Go Supervisord Process Manager
After=network.target

[Service]
Type=simple
User=root
Group=root
ExecStart=/usr/local/bin/supervisord -n -c /etc/supervisord/supervisord.conf
ExecReload=/usr/local/bin/supervisord -c /etc/supervisord/supervisord.conf ctl reload
Restart=on-failure
RestartSec=5s
TimeoutStopSec=90
UMask=0077

# Security and Limit Configurations
LimitNOFILE=65536
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
